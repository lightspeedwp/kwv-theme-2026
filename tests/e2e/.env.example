# KWV E2E — environment contract. Copy to `.env` and fill locally. NEVER commit `.env`.
# All values are read by playwright.config.ts / the specs. Use test data only.

# Base URL of the target environment (staging/preview — never production for stateful flows)
KWV_BASE_URL=https://kwv.lightspeedwp.dev

# --- Sandbox / stateful gating -------------------------------------------------
# Set to "1" to enable @stateful order-placing cases. PayFast is in TEST mode on
# dev and its sandbox completes WITHOUT a real card, so this flag alone is enough
# for end-to-end order placement via PayFast.
KWV_SANDBOX=0

# Only needed for the Payflex (BNPL) capture path — NOT required for PayFast sandbox.
# Leave blank unless testing Payflex capture with a gateway sandbox card.
KWV_TEST_CARD_NUMBER=
KWV_TEST_CARD_EXPIRY=
KWV_TEST_CARD_CVV=

# --- Test customer (for logged-in checkout) ------------------------------------
# Dedicated test account only — never a real customer. Leave blank until provided.
# NOTE: if a password contains '#', wrap the whole value in double quotes, else
# dotenv treats everything after '#' as a comment and truncates it.
KWV_TEST_CUSTOMER_EMAIL=
KWV_TEST_CUSTOMER_PASSWORD=

# --- Admin (for email-template verification via the WooCommerce email preview) --
# Emails are disabled on dev, so templates are checked through the admin preview,
# which needs an administrator. Leave blank to skip the @emails tests.
KWV_ADMIN_EMAIL=
KWV_ADMIN_PASSWORD=

# --- Test data -----------------------------------------------------------------
# Seeded product used by cart/checkout cases (id drives the server-side add-to-cart).
KWV_PRODUCT_ID=181708
KWV_PRODUCT_SLUG=kwv-classic-chardonnay-2025
KWV_PRODUCT_NAME=KWV Classic Chardonnay 2025

# Known test coupon for the discount case. Confirm validity + cart threshold before enabling.
# (Candidate PINOTAGE100 = 15% off orders over R500.)
KWV_COUPON_CODE=
