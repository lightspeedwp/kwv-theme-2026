{
	// Mutation testing: `composer test:mutation`. See tests/README.md.
	"$schema": "vendor/infection/infection/resources/schema.json",
	// Lets Infection itself load the Composer autoloader.
	"bootstrap": "tests/Unit/bootstrap.php",
	// The theme root, minus everything that is not PHP under test, so that
	// functions.php and inc/ are mutated. These configs run inside the workspace
	// built by tests/bin/mutation-workspace.php.
	"source": {
		"directories": ["."],
		"excludes": ["vendor", "build", "node_modules", "tests", "patterns", "templates", "parts", "assets", "styles", "index.php"]
	},
	"timeout": 60,
	"threads": "max",
	"tmpDir": "build/infection-tmp",
	"logs": {
		"text": "build/infection/unit.log",
		"summary": "build/infection/unit-summary.log"
	},
	"phpUnit": {
		"configDir": "."
	},
	"initialTestsPhpOptions": "-d pcov.enabled=1",
	"mutators": {
		"@default": true,
		// Narrowing a method's visibility can't be observed by a test that
		// calls the public API; these mutants are noise.
		"@function_signature": false
	}
}
